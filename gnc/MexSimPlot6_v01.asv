        'dela','delrc & delrc0','delec & delec0','dac1 & dac3','dac2 & dac4',' duPitch','x hm','duRoll','duYaw','mass','Thrust & thrust2','slantR ','Tgo'};%,'erre0 & erre1 & erre2'};%,'Pitch'};%,'Wy_phase','Wz_phase'};%,'CMDs'};


